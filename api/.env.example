# API process env (do not put VITE_* here — see frontend/.env.example)
APP_ENV=development
PORT=8080

DATABASE_URL=postgres://envm:envm_dev@localhost:5432/envm_vault?sslmode=disable

JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h

# 32-byte AES key as hex (generate: openssl rand -hex 32). Separate from JWT_SECRET.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY_VERSION=1

CORS_ORIGINS='["http://localhost:3100","http://127.0.0.1:3100"]'

# Optional: directory with Vue build (index.html). Empty = API only (local make dev).
# FRONTEND_DIST=

# Global HTTP rate limit (per IP). Health endpoints are exempt.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m
