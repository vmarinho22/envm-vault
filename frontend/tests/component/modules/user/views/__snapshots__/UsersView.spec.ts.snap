// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`UsersView (component) > blocks a user after confirm and reloads the list 1`] = `
"<div>
  <section class="px-8 py-10 md:px-12">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-medium tracking-tight md:text-3xl">Usuários</h1>
        <p class="mt-3 max-w-lg text-base text-base-content/70">Crie usuários, bloqueie o acesso e revogue chaves de API.</p>
      </div><button class="btn btn-primary gap-2" type="button"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
        </svg> Criar usuário</button>
    </div>
    <div class="mt-8 overflow-x-auto">
      <table class="table">
        <thead>
          <tr>
            <th>E-mail</th>
            <th>Papel</th>
            <th>Status</th>
            <th>Chave</th>
            <th><span class="sr-only">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <!--v-if-->
          <tr>
            <td>user@example.com</td>
            <td>Usuário</td>
            <td><span class="badge badge-sm badge-error">Bloqueado</span></td>
            <td class="font-mono text-sm">Revogada</td>
            <td class="text-right">
              <div class="flex justify-end gap-1"><button class="btn btn-ghost btn-square btn-sm" type="button" aria-label="Desbloquear"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5V6.75a4.5 4.5 0 1 1 9 0v3.75M3.75 21.75h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H3.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"></path>
                  </svg></button><button class="btn btn-error btn-outline btn-sm gap-2" type="button" disabled=""><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1 1 21.75 8.25Z"></path>
                  </svg> Revogar</button></div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
    <dialog id="user-form-modal" class="modal">
      <div class="modal-box max-w-md">
        <h3 class="text-lg font-medium">Novo usuário</h3>
        <form class="mt-4 space-y-4"><label class="form-control flex w-full flex-col gap-[4px]"><span class="label-text">E-mail</span><input class="input input-bordered w-full" type="email" name="user-email" autocomplete="off" required="" aria-label="E-mail" value=""></label><label class="form-control flex w-full flex-col gap-[4px]"><span class="label-text">Papel</span><select class="select select-bordered w-full" name="user-role" autocomplete="off" required="" aria-label="Papel" value="user">
              <option value="admin">Admin</option>
              <option value="user">Usuário</option>
            </select></label>
          <div class="modal-action"><button class="btn" type="button">Cancelar</button><button class="btn btn-primary" type="submit">
              <!--v-if--> Criar
            </button></div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop"><button type="submit">Cancelar</button></form>
    </dialog>
  </section>
  <dialog id="app-confirm-dialog" class="modal">
    <div class="modal-box max-w-md">
      <h3 class="text-lg font-medium">Bloquear</h3>
      <p class="mt-3 text-sm text-base-content/80">Bloquear "user@example.com"? O login e a chave de API serão desativados.</p>
      <div class="modal-action"><button class="btn" type="button" data-testid="confirm-cancel">Cancelar</button><button class="btn btn-error" type="button" data-testid="confirm-accept">Bloquear</button></div>
    </div>
    <form method="dialog" class="modal-backdrop"><button type="submit">Cancelar</button></form>
  </dialog>
</div>"
`;

