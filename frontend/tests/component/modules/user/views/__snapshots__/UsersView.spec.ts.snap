exports[`UsersView (component) > creates a user and reloads the list 1`] = `
"<section class="px-8 py-10 md:px-12">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-medium tracking-tight md:text-3xl">Usuários</h1>
      <p class="mt-3 max-w-lg text-base text-base-content/70">Crie usuários e revogue chaves de API. Quem perder a chave precisará gerar uma nova.</p>
    </div><button class="btn btn-primary gap-2" type="button"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
      </svg> Criar usuário</button>
  </div>
  <div class="mt-8 overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>E-mail</th>
          <th>Papel</th>
          <th>Chave</th>
          <th><span class="sr-only">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <!--v-if-->
        <tr>
          <td>admin@example.com</td>
          <td>Super admin</td>
          <td class="font-mono text-sm">ev_adminxxx</td>
          <td class="text-right"><button class="btn btn-error btn-outline btn-sm gap-2" type="button"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"></path>
              </svg> Revogar</button></td>
        </tr>
        <tr>
          <td>new@example.com</td>
          <td>Usuário</td>
          <td class="font-mono text-sm">Sem chave</td>
          <td class="text-right"><button class="btn btn-error btn-outline btn-sm gap-2" type="button" disabled=""><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"></path>
              </svg> Revogar</button></td>
        </tr>
      </tbody>
    </table>
  </div>
  <dialog id="user-form-modal" class="modal">
    <div class="modal-box max-w-md">
      <h3 class="text-lg font-medium">Novo usuário</h3>
      <form class="mt-4 space-y-4"><label class="form-control flex w-full flex-col gap-[4px]"><span class="label-text">E-mail</span><input class="input input-bordered w-full" type="email" name="user-email" autocomplete="off" required="" aria-label="E-mail" value="new@example.com"></label><label class="form-control flex w-full flex-col gap-[4px]"><span class="label-text">Papel</span><select class="select select-bordered w-full" name="user-role" autocomplete="off" required="" aria-label="Papel" value="admin">
            <option value="admin">Admin</option>
            <option value="user">Usuário</option>
          </select></label>
        <div class="modal-action"><button class="btn" type="button">Cancelar</button><button class="btn btn-primary" type="submit">
            <!--v-if--> Criar
          </button></div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button type="submit">Cancelar</button></form>
  </dialog>
</section>"
`;

