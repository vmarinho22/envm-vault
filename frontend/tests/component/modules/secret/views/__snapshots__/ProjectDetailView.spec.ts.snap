                  <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"></path>
                </svg></button><button class="btn btn-error btn-outline btn-square btn-sm" type="button" aria-label="Excluir"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"></path>
                </svg></button></div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <dialog id="secret-form-modal" class="modal">
    <div class="modal-box max-h-[90vh] max-w-lg overflow-y-auto">
      <h3 class="text-lg font-medium">Nova secret</h3>
      <form class="mt-4 space-y-4"><label class="form-control w-full"><span class="label-text">Nome</span><input class="input input-bordered w-full font-mono" type="text" name="secret-name" autocomplete="off" required="" pattern="[A-Za-z_][A-Za-z0-9_]*" maxlength="128" aria-label="Nome" value=""><span class="label-text-alt text-base-content/60">Letras, números e _ (ex.: DATABASE_URL)</span></label>
        <div class="form-control w-full">
          <div class="flex items-center justify-between gap-2"><span class="label-text my-1">Ambientes</span>
            <!--v-if-->
          </div><button class="input input-bordered flex min-h-10 w-full flex-wrap items-center gap-1 py-1 text-left focus:outline-none focus:ring-2 focus:ring-base-content/20" type="button" aria-expanded="false" aria-label="Ambientes"><span class="text-base-content/50">Selecione ambientes</span></button>
          <!--teleport start-->
          <!--v-if-->
          <!--teleport end-->
        </div>
        <!--v-if-->
        <div class="modal-action"><button class="btn" type="button">Cancelar</button><button class="btn btn-primary" type="submit" disabled="">Criar</button></div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button type="submit">Cancelar</button></form>
  </dialog>
</section>"
`;
