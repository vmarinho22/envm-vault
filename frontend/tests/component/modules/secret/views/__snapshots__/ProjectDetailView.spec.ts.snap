      <h3 class="text-lg font-medium">Nova secret</h3>
      <form class="mt-4 space-y-4"><label class="form-control w-full"><span class="label-text">Nome</span><input class="input input-bordered w-full font-mono" type="text" name="secret-name" autocomplete="off" required="" pattern="[A-Za-z_][A-Za-z0-9_]*" maxlength="128" aria-label="Nome" value=""><span class="label-text-alt text-base-content/60">Letras, números e _ (ex.: DATABASE_URL)</span></label>
