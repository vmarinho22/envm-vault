// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SecretsView > applies title search 1`] = `
"<section class="px-8 py-10 md:px-12">
  <div>
    <h1 class="text-2xl font-medium tracking-tight md:text-3xl">Secrets</h1>
    <p class="mt-3 max-w-lg text-base text-base-content/70">Catálogo global de variáveis de ambiente compartilhadas entre projetos.</p>
  </div>
  <form class="mt-8 flex flex-wrap items-end gap-3">
    <div class="w-full max-w-xs"><input class="input input-bordered w-full" type="search" name="secret-catalog-search" autocomplete="off" placeholder="Nome (ex.: DATABASE_URL)" aria-label="Buscar variáveis"></div><button class="btn btn-outline" type="submit">Aplicar</button><button class="btn btn-ghost" type="button">Limpar</button>
  </form>
  <div class="mt-8 overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Projetos</th>
          <th>Criação</th>
        </tr>
      </thead>
      <tbody>
        <!--v-if-->
        <tr class="cursor-pointer transition-colors hover:bg-base-200/70" tabindex="0" role="link" aria-label="DATABASE_URL">
          <td class="font-mono text-sm font-medium">DATABASE_URL</td>
          <td>2</td>
          <td>12/31/2025 21:00</td>
        </tr>
      </tbody>
    </table>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-base-content/70">Página 1 de 1 (1 no total)</p>
      <div class="flex gap-2"><button class="btn btn-outline btn-sm" type="button" disabled="">Anterior</button><button class="btn btn-outline btn-sm" type="button" disabled="">Próxima</button></div>
    </div>
  </div>
</section>"
`;

