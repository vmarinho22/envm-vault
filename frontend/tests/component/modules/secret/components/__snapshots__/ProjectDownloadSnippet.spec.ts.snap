exports[`ProjectDownloadSnippet > includes production for super_admin 1`] = `
"<div class="rounded-lg border border-base-300 bg-base-200/40 p-4 md:p-5">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div class="min-w-0 flex-1">
      <h2 class="text-base font-medium">Baixar .env no projeto</h2>
      <p class="mt-1 max-w-2xl text-sm text-base-content/70">Cole no terminal do repositório. Use sua chave de API pessoal (ev_…) e escolha o ambiente.</p>
    </div>
    <div class="flex flex-wrap items-end gap-2"><label class="form-control w-40 sm:w-48"><span class="label-text">Ambiente</span><select class="select select-bordered select-sm" aria-label="Ambiente">
          <!--v-if-->
          <option value="dev">dev</option>
          <option value="production">production</option>
        </select></label><button class="btn btn-outline btn-sm gap-2" type="button" data-testid="copy-download-snippet"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 7.5V6.108c0-1.135.845-2.098 1.976-2.192.373-.03.748-.057 1.123-.08M15.75 18H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08M15.75 18.75v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5A3.375 3.375 0 0 0 6.375 7.5H5.25m11.9-3.664A2.251 2.251 0 0 0 15 2.25h-1.5a2.251 2.251 0 0 0-2.15 1.586m5.8 0c.065.21.1.433.1.664v.75h-6V4.5c0-.231.035-.454.1-.664M6.75 7.5H4.875c-.621 0-1.125.504-1.125 1.125v12c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V16.5a9 9 0 0 0-9-9Z"></path>
        </svg> Copiar</button></div>
  </div>
  <div role="tablist" class="tabs tabs-boxed mt-4 w-fit bg-base-300/50"><button type="button" role="tab" class="tab tab-active" aria-selected="true">Linux</button><button type="button" role="tab" class="tab" aria-selected="false">macOS</button><button type="button" role="tab" class="tab" aria-selected="false">Windows</button></div><pre class="mt-3 max-h-56 overflow-auto rounded-md border border-base-300 bg-base-100 p-3 font-mono text-xs leading-relaxed" data-testid="download-snippet"># Set your personal API key once in the session:
#   export ENVM_TOKEN="ev_…"
curl -fsSL \\
  -H "Authorization: Bearer \${ENVM_TOKEN}" \\
  "http://localhost:8080/v1/projects/envm-api/env?environment=dev&amp;format=env" \\
  -o .env</pre>
  <p class="mt-3 text-xs text-base-content/60">Defina ENVM_TOKEN com a chave gerada em Chave de API. O arquivo .env é gravado no diretório atual.</p>
  <!--v-if-->
</div>"
`;

