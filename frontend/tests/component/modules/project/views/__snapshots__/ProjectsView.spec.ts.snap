exports[`ProjectsView (component) > hides delete for standard user but keeps create/edit 1`] = `
"<section class="px-8 py-10 md:px-12">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-medium tracking-tight md:text-3xl">Projetos</h1>
      <p class="mt-3 max-w-lg text-base text-base-content/70">Projetos concentram times, ambientes e tags. Qualquer usuário pode criar e editar; apenas administradores podem excluir.</p>
    </div><button class="btn btn-primary gap-2" type="button"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
      </svg> Criar projeto</button>
  </div>
  <form class="mt-8 flex flex-wrap items-end gap-3">
    <div class="w-full max-w-xs"><input class="input input-bordered w-full" type="search" name="project-title-search" autocomplete="off" placeholder="Ex.: payment-service" aria-label="Buscar por título"></div>
    <div class="w-full max-w-xs">
      <div class="form-control w-full">
        <div class="flex items-center justify-between gap-2"><span class="label-text my-1">Times</span>
          <!--v-if-->
        </div><button class="input input-bordered flex min-h-10 w-full flex-wrap items-center gap-1 py-1 text-left focus:outline-none focus:ring-2 focus:ring-base-content/20" type="button" aria-expanded="false" aria-label="Times"><span class="text-base-content/50">Todos os times</span></button>
        <!--teleport start-->
        <!--v-if-->
        <!--teleport end-->
      </div>
    </div>
    <div class="w-full max-w-xs">
      <div class="form-control w-full">
        <div class="flex items-center justify-between gap-2"><span class="label-text my-1">Tags</span>
          <!--v-if-->
        </div><button class="input input-bordered flex min-h-10 w-full flex-wrap items-center gap-1 py-1 text-left focus:outline-none focus:ring-2 focus:ring-base-content/20" type="button" aria-expanded="false" aria-label="Tags"><span class="text-base-content/50">Todas as tags</span></button>
        <!--teleport start-->
        <!--v-if-->
        <!--teleport end-->
      </div>
    </div><button class="btn btn-outline" type="submit">Buscar</button>
    <!--v-if-->
  </form>
  <div class="mt-8 overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Título</th>
          <th>Times</th>
          <th>Tags</th>
          <th>Criado em</th>
          <th><span class="sr-only">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <!--v-if-->
        <tr class="cursor-pointer transition-colors hover:bg-base-200/70" tabindex="0" role="link" aria-label="Payment">
          <td class="font-medium">Payment</td>
          <td><span class="flex flex-wrap gap-1"><span class="badge badge-ghost badge-sm">Platform</span>
            <!--v-if--></span>
          </td>
          <td><span class="flex flex-wrap gap-1"><span class="badge badge-sm gap-1 border border-base-300"><span class="inline-block size-2 rounded-full" style="background-color: rgb(0, 0, 0);" aria-hidden="true"></span> backend</span>
            <!--v-if--></span>
          </td>
          <td>12/31/2025</td>
          <td class="text-right">
            <div class="flex justify-end gap-1"><button class="btn btn-ghost btn-square btn-sm" type="button" aria-label="Editar"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"></path>
                </svg></button>
              <!--v-if-->
            </div>
          </td>
        </tr>
      </tbody>
    </table>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-base-content/70">Página 1 de 1 (1 no total)</p>
      <div class="flex gap-2"><button class="btn btn-outline btn-sm" type="button" disabled="">Anterior</button><button class="btn btn-outline btn-sm" type="button" disabled="">Próxima</button></div>
    </div>
  </div>
  <dialog id="project-form-modal" class="modal">
    <div class="modal-box flex max-h-[85vh] max-w-lg flex-col overflow-hidden">
      <h3 class="shrink-0 text-lg font-medium">Novo projeto</h3>
      <form class="mt-4 flex min-h-0 flex-1 flex-col">
        <div class="min-h-0 flex-1 space-y-4 overflow-y-auto pr-1"><label class="form-control w-full"><span class="label-text my-1">Título</span><input class="input input-bordered w-full" type="text" name="project-title" autocomplete="off" required="" maxlength="80" aria-label="Título" value=""></label>
          <p class="text-sm text-base-content/60">Slug: <span class="font-mono">—</span></p>
          <div class="form-control w-full">
            <div class="flex items-center justify-between gap-2"><span class="label-text my-1">Times</span>
              <!--v-if-->
            </div><button class="input input-bordered flex min-h-10 w-full flex-wrap items-center gap-1 py-1 text-left focus:outline-none focus:ring-2 focus:ring-base-content/20" type="button" aria-expanded="false" aria-label="Times"><span class="text-base-content/50">Selecione times</span></button>
            <!--teleport start-->
            <!--v-if-->
            <!--teleport end-->
          </div>
          <div class="form-control w-full">
            <div class="flex items-center justify-between gap-2"><span class="label-text my-1">Ambientes</span>
              <!--v-if-->
            </div><button class="input input-bordered flex min-h-10 w-full flex-wrap items-center gap-1 py-1 text-left focus:outline-none focus:ring-2 focus:ring-base-content/20" type="button" aria-expanded="false" aria-label="Ambientes"><span class="text-base-content/50">Selecione ambientes</span></button>
            <!--teleport start-->
            <!--v-if-->
            <!--teleport end-->
          </div>
          <div class="form-control w-full">
            <div class="flex items-center justify-between gap-2"><span class="label-text my-1">Tags</span><button class="btn btn-ghost btn-square btn-xs" type="button" aria-label="Adicionar tag" title="Adicionar tag"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
                </svg></button></div><button class="input input-bordered flex min-h-10 w-full flex-wrap items-center gap-1 py-1 text-left focus:outline-none focus:ring-2 focus:ring-base-content/20" type="button" aria-expanded="false" aria-label="Tags"><span class="text-base-content/50">Selecione tags</span></button>
            <!--teleport start-->
            <!--v-if-->
            <!--teleport end-->
          </div>
        </div>
        <div class="modal-action shrink-0"><button class="btn" type="button">Cancelar</button><button class="btn btn-primary" type="submit">
            <!--v-if--> Criar
          </button></div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button type="submit">Cancelar</button></form>
  </dialog>
</section>"
`;

