exports[`TagsView (component) > renders tags and mutate actions for standard user 1`] = `
"<section class="px-8 py-10 md:px-12">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-medium tracking-tight md:text-3xl">Tags</h1>
      <p class="mt-3 max-w-lg text-base text-base-content/70">Etiquetas para identificar projetos. Qualquer usuário autenticado pode criar, editar e excluir.</p>
    </div><button class="btn btn-primary gap-2" type="button"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path>
      </svg> Criar tag</button>
  </div>
  <form class="mt-8 flex flex-wrap items-end gap-3">
    <div class="w-full max-w-xs"><input class="input input-bordered w-full" type="search" name="tag-title-search" autocomplete="off" placeholder="Ex.: backend" aria-label="Buscar por título"></div><button class="btn btn-outline" type="submit">Buscar</button>
    <!--v-if-->
  </form>
  <div class="mt-8 overflow-x-auto">
    <table class="table">
      <thead>
        <tr>
          <th>Título</th>
          <th>Cor</th>
          <th>Criado em</th>
          <th>Atualizado em</th>
          <th><span class="sr-only">Ações</span></th>
        </tr>
      </thead>
      <tbody>
        <!--v-if-->
        <tr>
          <td>Backend</td>
          <td><span class="inline-flex items-center gap-2"><span class="inline-block size-4 shrink-0 rounded-full border border-base-300" style="background-color: rgb(99, 102, 241);" aria-hidden="true"></span><span class="font-mono text-sm">#6366F1</span></span></td>
          <td>12/31/2025</td>
          <td>01/01/2026</td>
          <td class="text-right">
            <div class="flex justify-end gap-1"><button class="btn btn-ghost btn-square btn-sm" type="button" aria-label="Editar"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"></path>
                </svg></button><button class="btn btn-error btn-outline btn-square btn-sm" type="button" aria-label="Excluir"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"></path>
                </svg></button></div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  <dialog id="tag-form-modal" class="modal">
    <div class="modal-box max-w-md">
      <h3 class="text-lg font-medium">Nova tag</h3>
      <form class="mt-4 space-y-4"><label class="form-control w-full"><span class="label-text">Título</span><input class="input input-bordered w-full" type="text" name="tag-title" autocomplete="off" required="" maxlength="80" aria-label="Título" value=""></label>
        <div class="form-control w-full"><span class="label-text">Cor</span>
          <div class="mt-1 flex items-center gap-2"><input class="h-10 w-14 cursor-pointer rounded border border-base-300 bg-transparent p-1" type="color" name="tag-color-picker" aria-label="Seletor de cor" value="#6366F1"><input class="input input-bordered min-w-0 flex-1 font-mono uppercase" type="text" name="tag-color-hex" autocomplete="off" required="" maxlength="7" pattern="#[0-9A-Fa-f]{6}" aria-label="Cor em hexadecimal" value="#6366F1"><button class="btn btn-ghost btn-square" type="button" aria-label="Sortear cor" title="Sortear cor"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon" class="size-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"></path>
              </svg></button></div>
        </div>
        <div class="modal-action"><button class="btn" type="button">Cancelar</button><button class="btn btn-primary" type="submit">
            <!--v-if--> Criar
          </button></div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button type="submit">Cancelar</button></form>
  </dialog>
</section>"
`;

