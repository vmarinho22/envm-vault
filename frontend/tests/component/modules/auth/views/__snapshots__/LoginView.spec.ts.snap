exports[`LoginView (component) > calls verifyLogin and stores the session on success 1`] = `
"<main class="vault-bg flex min-h-svh items-end px-6 pb-16 md:items-center md:px-16 md:pb-0">
  <section class="mx-auto w-full max-w-xl">
    <p class="font-brand vault-enter text-5xl leading-none tracking-tight text-base-content md:text-7xl"> envm-vault </p>
    <h1 class="vault-enter-delay mt-8 max-w-md text-2xl font-medium leading-snug text-base-content md:text-3xl"> Entre para gerenciar os ambientes. </h1>
    <p class="vault-enter-delay mt-3 max-w-md text-base text-base-content/70"> Enviamos um código de 8 dígitos para o seu e-mail. </p>
    <form class="vault-step mt-10 flex max-w-md flex-col gap-4">
      <div class="flex flex-col gap-2"><span class="text-sm font-medium">Código</span>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Código de verificação"><input class="input input-bordered w-10 px-0 text-center text-base tracking-normal" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" name="code" autocomplete="one-time-code" aria-label="Dígito 1" value="1"><input class="input input-bordered w-10 px-0 text-center text-base tracking-normal" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="off" aria-label="Dígito 2" value="2"><input class="input input-bordered w-10 px-0 text-center text-base tracking-normal" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="off" aria-label="Dígito 3" value="3"><input class="input input-bordered w-10 px-0 text-center text-base tracking-normal" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="off" aria-label="Dígito 4" value="4"><input class="input input-bordered w-10 px-0 text-center text-base tracking-normal" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="off" aria-label="Dígito 5" value="5"><input class="input input-bordered w-10 px-0 text-center text-base tracking-normal" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="off" aria-label="Dígito 6" value="6"><input class="input input-bordered w-10 px-0 text-center text-base tracking-normal" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="off" aria-label="Dígito 7" value="7"><input class="input input-bordered w-10 px-0 text-center text-base tracking-normal" type="text" inputmode="numeric" maxlength="1" pattern="[0-9]" autocomplete="off" aria-label="Dígito 8" value="8"></div>
      </div>
      <!--v-if-->
