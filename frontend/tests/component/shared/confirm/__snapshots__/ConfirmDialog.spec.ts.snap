// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ConfirmDialog (component) > renders closed by default 1`] = `
"<dialog id="app-confirm-dialog" class="modal">
  <div class="modal-box max-w-md">
    <h3 class="text-lg font-medium"></h3>
    <p class="mt-3 text-sm text-base-content/80"></p>
    <div class="modal-action"><button class="btn" type="button" data-testid="confirm-cancel"></button><button class="btn btn-error" type="button" data-testid="confirm-accept"></button></div>
  </div>
  <form method="dialog" class="modal-backdrop"><button type="submit"></button></form>
</dialog>"
`;

exports[`ConfirmDialog (component) > shows title, message and danger confirm button when opened 1`] = `
"<dialog id="app-confirm-dialog" class="modal">
  <div class="modal-box max-w-md">
    <h3 class="text-lg font-medium">Revogar chave?</h3>
    <p class="mt-3 text-sm text-base-content/80">Esta ação não pode ser desfeita.</p>
    <div class="modal-action"><button class="btn" type="button" data-testid="confirm-cancel">Cancelar</button><button class="btn btn-error" type="button" data-testid="confirm-accept">Revogar</button></div>
  </div>
  <form method="dialog" class="modal-backdrop"><button type="submit">Cancelar</button></form>
</dialog>"
`;

exports[`ConfirmDialog (component) > uses primary variant when requested 1`] = `
"<dialog id="app-confirm-dialog" class="modal">
  <div class="modal-box max-w-md">
    <h3 class="text-lg font-medium">Confirmar</h3>
    <p class="mt-3 text-sm text-base-content/80">Prosseguir?</p>
    <div class="modal-action"><button class="btn" type="button" data-testid="confirm-cancel">Voltar</button><button class="btn btn-primary" type="button" data-testid="confirm-accept">OK</button></div>
  </div>
  <form method="dialog" class="modal-backdrop"><button type="submit">Voltar</button></form>
</dialog>"
`;
