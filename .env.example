# API + Docker Compose secrets (do not put VITE_* here — see frontend/.env.example)
APP_ENV=development
PORT=8080

POSTGRES_USER=envm
POSTGRES_PASSWORD=envm_dev
POSTGRES_DB=envm_vault
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgres://envm:envm_dev@localhost:5432/envm_vault?sslmode=disable

JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h

CORS_ORIGINS='["http://localhost:3100","http://127.0.0.1:3100"]'

# Global HTTP rate limit (per IP). Health endpoints are exempt.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1m
